# Pontifex site settings. ./setup.sh writes .env for you; or copy this to .env and edit.

# This server's LAN address, and the HTTP port for menus and images
PONTIFEX_IP=192.168.1.10
PONTIFEX_PORT=8069
# Address to bind the HTTP port to (default: PONTIFEX_IP). 0.0.0.0 = all interfaces.
#PONTIFEX_BIND=192.168.1.10

# LAN interface and network for proxyDHCP (network address only, as dnsmasq wants it)
PONTIFEX_IFACE=eth0
PONTIFEX_SUBNET=192.168.1.0

# Where Pontifex keeps library/ (your symlinks), cache/, tftp/ and hosts.conf
PONTIFEX_DATA=/srv/pontifex

# Folders your library links point into, space separated. They're mounted read-only at
# the same path inside the containers (docker-compose.override.yml, made by setup.sh).
PONTIFEX_SOURCES=/srv/isos

# User the menu service runs as (owns cache/)
PONTIFEX_UID=1000
PONTIFEX_GID=1000
